{
  "name": "mon-projet",
  "version": "1.0.0",
  "description": "NOVA Desktop Application",
  "author": "NOVA",
  "main": "expo-router/entry",
  "private": true,
  "dependencies": {
    "@expo/ui": "~57.0.13",
    "@react-native-community/datetimepicker": "9.1.0",
    "cors": "^2.8.6",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "http-server": "^14.1.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop:build": "expo export --platform web",
    "desktop": "npm run desktop:build && electron electron.js",
    "dist": "npm run desktop:build && electron-builder --win nsis",
    "dist:portable": "npm run desktop:build && electron-builder --win portable",
    "lint": "expo lint"
  },
  "build": {
    "appId": "com.nova.downtime",
    "productName": "NOVA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "NOVA-Portable-${version}.exe"
    }
  }
}
